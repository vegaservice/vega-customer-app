{
  "expo": {
    "name": "VEGA Home Services",
    "slug": "vega-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0800"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vegavizag.app",
      "buildNumber": "1",
      "appleTeamId": "73RYNYV3JU",
      "infoPlist": {
        "NSCameraUsageDescription": "VEGA needs camera access for service photos",
        "NSPhotoLibraryUsageDescription": "VEGA needs photo access for service photos",
        "NSLocationWhenInUseUsageDescription": "VEGA needs location to find services near you"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8520A"
      },
      "package": "com.vegavizag.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8520A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a2cb81a3-7b99-49f5-9ec4-6ace8e81d762"
      }
    },
    "owner": "mahesh1331"
  }
}
