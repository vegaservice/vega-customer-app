// VEGA HOME SERVICES — Firestore Security Rules
// ═══════════════════════════════════════════════════
// HOW TO APPLY THESE RULES:
// 1. Go to https://console.firebase.google.com
// 2. Open: vega-home-service project
// 3. Click: Firestore Database → Rules tab
// 4. Replace the default rules with the content below
// 5. Click: Publish
// ═══════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────
    // Phase 1 (launch): Permissive rules so app works reliably
    // Phase 2 (after 100 customers): Tighten with request.auth checks
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── BOOKINGS ──────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── PROFESSIONALS ─────────────────────────────────────
    match /professionals/{proId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;  // Admin only (via console for now)
    }

    // ── APP CONFIG (promo codes, settings) ────────────────
    match /app_config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;  // Admin only
    }

    // ── AREAS (Vizag serviceable areas) ───────────────────
    match /areas/{areaId} {
      allow read: if request.auth != null;
      allow write: if false;  // Admin only
    }

    // ── SUBCOLLECTION: users/{id}/bookings ────────────────
    match /users/{userId}/bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }
  }
}
