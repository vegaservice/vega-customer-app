// VEGA HOME SERVICES — Firestore Security Rules
// ═══════════════════════════════════════════════════
// Phase 1 (launch): Permissive — any authenticated user can read/write
// Phase 2 (after 100 customers): Tighten to per-user ownership checks
// ═══════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── USER SUBCOLLECTION: bookings (mirror) ──────────────
    match /users/{userId}/bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    // ── USER SUBCOLLECTION: saved addresses (Bug 7) ────────
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if request.auth != null;
    }

    // ── BOOKINGS (top-level) ───────────────────────────────
    match /bookings/{bookingId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── WORKERS (location tracking, assignment) ────────────
    match /workers/{workerId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── WORKER LOCATION TRAIL (subcollection — route history for Admin map) ─
    match /workers/{workerId}/location_trail/{trailId} {
      allow read, write: if request.auth != null;
    }

    // ── WALLET TRANSACTIONS (Bug 2 — audit trail for credits) ─
    match /wallet_transactions/{txnId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;   // Immutable ledger — never edit
      allow delete: if false;
    }

    // ── SERVICE INTERESTS (analytics: which services tapped) ─
    match /service_interests/{interestId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // ── REFERRALS (track who-referred-who, prevent abuse) ──
    match /referrals/{referralId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── PROFESSIONALS (legacy — kept for compatibility) ────
    match /professionals/{proId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // ── APP CONFIG (promo codes, payment public keys, settings) ────────
    // PUBLIC READ — Razorpay key_id is a PUBLIC client identifier (safe to expose).
    // Write is admin-only via Firebase Console (no app code writes here).
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ── AREAS (Vizag serviceable areas) ────────────────────
    match /areas/{areaId} {
      allow read: if request.auth != null;
      allow write: if false;   // Admin only
    }

    // ── FCM TOKENS (push notification targets) ─────────────
    match /fcm_tokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    // ── COMPLAINTS (Hub Manager handles customer complaints) ─
    match /complaints/{complaintId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── ADMINS (Admin app creates a doc on first login) ────
    match /admins/{adminId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── LOCATION_TRAIL (Worker GPS trail history) ──────────
    match /location_trail/{trailId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── BUG REPORTS (in-app bug button writes here) ────────
    match /bug_reports/{reportId} {
      allow create: if true;                 // any user (logged-in or guest)
      allow read:   if request.auth != null; // admin/dev reads via Console
      allow update: if request.auth != null; // status updates (resolved etc.)
      allow delete: if false;
    }

    // ── AREA REQUESTS (customer taps "Notify me" on coming-soon area) ─
    // Captures demand outside our 3 active areas so we know where to expand.
    match /area_requests/{requestId} {
      allow create: if true;                 // any user (even pre-login flows)
      allow read:   if request.auth != null; // admin reads via Console
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── DEFAULT: deny everything else ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
