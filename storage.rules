rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Job before/after photos — uploaded by authenticated workers; read by any signed-in
    // app user (worker/hub/admin/customer who needs to view proof).
    match /bookings/{bookingId}/{phase}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Bug-report screenshots
    match /bug_reports/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 12 * 1024 * 1024;
    }

    // Everything else denied
    match /{allPaths=**} { allow read, write: if false; }
  }
}
